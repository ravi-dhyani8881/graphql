extend type Query {
 findUserByQuery(query: String, start: String, rows: String, filterField: String, filterQuery: [String], sort: String, advanceField: String, advanceQuery: String, advance: String): UserResponse
}

type UserResponse {
  data: [RecordsUser]
  pagination: Pagination
  advanced: [Advanced]
}
     
type RecordsUser {
ID: String
username: String
createdAt: String
updatedAt: String
email: String

}