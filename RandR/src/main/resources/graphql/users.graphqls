extend type Query {
 findusersByQuery(query: String, start: String, rows: String, filterField: String, filterQuery: [String], sort: String, advanceField: String, advanceQuery: String, advance: String): usersResponse
}

type usersResponse {
  data: [Recordsusers]
  pagination: Pagination
  advanced: [Advanced]
}
     
type Recordsusers {
ID: String
username: String
email: String
createdAt: String
updatedAt: String

    findreviewsByQuery(query: String, start: String, rows: String, filterField: String, filterQuery: [String], sort: String, advanceField: String, advanceQuery: String, advance: String ): reviewsResponse
    findreview_responsesByQuery(query: String, start: String, rows: String, filterField: String, filterQuery: [String], sort: String, advanceField: String, advanceQuery: String, advance: String ): review_responsesResponse
}